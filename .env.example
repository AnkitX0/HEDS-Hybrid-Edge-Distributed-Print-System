# ==============================================================================
# HEDS — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development.
# In production, inject these variables via secure secret managers (e.g., AWS SSM, Vault).

# --- Application Environment ---
APP_ENV=development # development | test | production
DEBUG=true
PROJECT_NAME="HEDS - Hybrid Edge Distributed Print System"

# --- Backend API Service ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=generate-a-strong-random-32-byte-hex-string-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours

# --- PostgreSQL Database ---
POSTGRES_USER=heds_user
POSTGRES_PASSWORD=heds_secure_password
POSTGRES_DB=heds_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://heds_user:heds_secure_password@localhost:5432/heds_db
SYNC_DATABASE_URL=postgresql://heds_user:heds_secure_password@localhost:5432/heds_db

# --- Document Storage Engine ---
STORAGE_BACKEND=local # local | minio | s3
STORAGE_LOCAL_DIR=./storage_data
DOCUMENT_RETENTION_HOURS=24
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=heds-documents
MINIO_SECURE=false

# --- Payment Gateway Integration ---
PAYMENT_GATEWAY=mock # mock | razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Edge Agent Daemon ---
HEDS_CLOUD_URL=http://localhost:8000
HEDS_AGENT_KEY=agnt_secure_agent_key_generated_in_cloud
HEDS_SHOP_ID=b52a6ecb-5dbc-4e41-a8cb-88f05f68859a
HEDS_AGENT_ID=467674bf-343b-4484-adde-efc923c87db3
HEDS_PRINTER_ADAPTER=mock # mock | cups
MOCK_PRINTER_PAGES_PER_SECOND=2.0
MOCK_PRINTER_FAILURE_RATE=0.0
JOB_LEASE_DURATION_SECONDS=60
AGENT_HEARTBEAT_TIMEOUT_SECONDS=45

# --- Frontend Applications Configuration ---
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3002
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Allowed CORS Origins (Comma-separated or JSON list) ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002","http://localhost:8000"]
