# Application Environment
APP_ENV=development
DEBUG=true
PROJECT_NAME="HEDS - Hybrid Edge Distributed Print System"

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=heds-super-secret-key-change-in-production-min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL)
POSTGRES_USER=heds_user
POSTGRES_PASSWORD=heds_secure_password
POSTGRES_DB=heds_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://heds_user:heds_secure_password@localhost:5432/heds_db
SYNC_DATABASE_URL=postgresql://heds_user:heds_secure_password@localhost:5432/heds_db

# Object Storage (MinIO / S3 compatible)
STORAGE_BACKEND=local # options: local, minio, s3
STORAGE_LOCAL_DIR=./storage_data
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=heds-documents
MINIO_SECURE=false

# Payment Gateway
PAYMENT_GATEWAY=mock # options: mock, razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Edge Agent Configuration
HEDS_CLOUD_URL=http://localhost:8000
HEDS_AGENT_KEY=agent-dev-key-12345
HEDS_SHOP_ID=
HEDS_AGENT_ID=
HEDS_PRINTER_ADAPTER=mock # options: mock, cups
MOCK_PRINTER_PAGES_PER_SECOND=2.0
MOCK_PRINTER_FAILURE_RATE=0.0

# CORS Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8000"]
