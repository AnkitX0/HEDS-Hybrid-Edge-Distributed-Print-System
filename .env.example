# ==============================================================================
# HEDS — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development.
# In cloud deployments (Render, Vercel, Neon), inject these variables via each
# provider's environment variables dashboard.
# NEVER commit real passwords, tokens, or secret keys to source control.

# --- Application Environment ---
# Options: development | test | production
# In production, debug endpoints and mock payment bypasses are strictly locked down.
APP_ENV=development
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="HEDS - Hybrid Edge Distributed Print System"

# --- Backend API Service (FastAPI / Render Web Service) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Generate a strong 32+ character hex secret: openssl rand -hex 32
SECRET_KEY=generate-a-strong-random-32-byte-hex-string-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours

# --- PostgreSQL Database (Neon Serverless PostgreSQL / Local Docker) ---
# Neon provides a connection string formatted as: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
# The HEDS backend automatically normalizes postgresql:// to postgresql+asyncpg:// for async sessions,
# and derives SYNC_DATABASE_URL automatically for Alembic migrations.
POSTGRES_USER=heds_user
POSTGRES_PASSWORD=heds_secure_password
POSTGRES_DB=heds_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://heds_user:heds_secure_password@localhost:5432/heds_db
SYNC_DATABASE_URL=postgresql://heds_user:heds_secure_password@localhost:5432/heds_db

# --- Document Storage Engine (Private S3-Compatible Storage / Cloudflare R2 / Local) ---
# STORAGE_BACKEND options:
#   local -> Stores documents in STORAGE_LOCAL_DIR (development only)
#   s3    -> AWS S3 or Cloudflare R2 (recommended for cloud deployment)
#   minio -> Self-hosted MinIO object storage
# NOTE: Uploaded documents and spool files are NEVER publicly readable. All downloads
# are mediated via backend authenticated streaming endpoints.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage_data
DOCUMENT_RETENTION_HOURS=24

# Cloudflare R2 / AWS S3 Configuration (Required if STORAGE_BACKEND=s3):
# Cloudflare R2 endpoint format: <account_id>.r2.cloudflarestorage.com (omit https://)
# AWS S3 endpoint format: s3.<region>.amazonaws.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=heds-documents
S3_REGION=auto
S3_SECURE=true

# MinIO Local Development Fallback:
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=heds-documents
MINIO_SECURE=false

# --- Payment Gateway Integration ---
# PAYMENT_GATEWAY options:
#   mock     -> Simulated payment gateway for examiner demonstration and testing.
#   razorpay -> Authoritative Razorpay REST orders and HMAC-SHA256 signature verification.
PAYMENT_GATEWAY=mock
ALLOW_MOCK_PAYMENTS=false # Auto-enabled in development/demo. Set true only if running mock demo in cloud.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Cloud Mock Print Worker (Examiner / Mentor Demonstration Mode) ---
# When set to true, an isolated cloud worker automatically simulates edge agent spooling
# and execution for queued orders without requiring a physical printer or local laptop.
# Adheres strictly to the centralized state machine: QUEUED -> DISPATCHED -> PRINTING -> PRINT_COMPLETED -> PICKUP_READY.
ENABLE_MOCK_PRINT_WORKER=false
MOCK_WORKER_INTERVAL_SECONDS=3.0

# --- Edge Agent Daemon (Optional when running physical or laptop edge agent) ---
HEDS_CLOUD_URL=http://localhost:8000
HEDS_AGENT_KEY=agnt_secure_agent_key_generated_in_cloud
HEDS_SHOP_ID=b52a6ecb-5dbc-4e41-a8cb-88f05f68859a
HEDS_AGENT_ID=467674bf-343b-4484-adde-efc923c87db3
HEDS_PRINTER_ADAPTER=mock # mock | cups
MOCK_PRINTER_PAGES_PER_SECOND=2.0
MOCK_PRINTER_FAILURE_RATE=0.0
JOB_LEASE_DURATION_SECONDS=60
AGENT_HEARTBEAT_TIMEOUT_SECONDS=45

# --- Allowed CORS Origins (FastAPI Backend) ---
# Explicit list of allowed frontend origins (Comma-separated or JSON array).
# Wildcard '*' is strictly prohibited when credentials are enabled.
# Example for production:
# CORS_ORIGINS=https://heds-student-qr.vercel.app,https://heds-student-web.vercel.app,https://heds-shop-dashboard.vercel.app
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002","http://localhost:8000"]

# --- Frontend Applications Configuration (Vercel) ---
# Set these environment variables in your Vercel project settings:
# BACKEND_URL: The deployed HTTPS FastAPI backend URL (e.g. https://heds-backend.onrender.com)
# NEXT_PUBLIC_STOREFRONT_URL: The deployed HTTPS URL of the Student QR app (e.g. https://heds-student-qr.vercel.app)
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:8000
